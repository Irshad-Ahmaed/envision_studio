# MongoDB Atlas or transaction-capable replica-set connection string. Keep server-side; never prefix with NEXT_PUBLIC_.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Exact origins allowed to submit browser mutations. Comma-separated in hosted environments.
APP_ALLOWED_ORIGINS=http://localhost:3000

# Optional seed fixture path. Defaults to the supplied local assessment fixture.
SEED_FILE=./data/assessment-mock.json
